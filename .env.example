# ===================================================================
# QUORV BRAND STUDIO — PRODUCTION ENVIRONMENT CONFIGURATION
# ===================================================================

# 1. Django Core
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=quorv.com,www.quorv.com,127.0.0.1,localhost

# 2. Database (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://quorv_user:your_db_password@localhost:5432/quorv_db

# 3. Security & HTTPS (Set to True in production with SSL)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_CSRF_TRUSTED_ORIGINS=https://quorv.com,https://www.quorv.com

# 4. Email Notifications (SendGrid, Postmark, AWS SES, or Gmail SMTP)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_sendgrid_or_smtp_api_key_here
DEFAULT_FROM_EMAIL=QUORV Brand Studio <noreply@quorv.com>
STUDIO_NOTIFICATION_EMAIL=quorv911@gmail.com

# 5. Studio Channels
WHATSAPP_NUMBER=+447352789073
STUDIO_EMAIL=quorv911@gmail.com
